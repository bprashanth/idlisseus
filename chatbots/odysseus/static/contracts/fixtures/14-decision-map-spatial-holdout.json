 "answer": {
  "headline": "The whole-landscape holdout for regenerating tree species richness passed; 8 existing plots are selected for a knowledge-focused resurvey.",
  "detail": "Held-out mean absolute error was 4.93 species per 0.04 ha plot versus 6.06 for the training-mean baseline (18.6% better). Large errors identify where the simple model needs learning, not where restoration failed.",
  "evidence_classes": [
   "observed",
   "derived",
   "modelled"
  ],
  "validation": {
   "kind": "spatial-holdout",
   "status": "passed",
